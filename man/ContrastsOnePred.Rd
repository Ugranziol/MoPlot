random_intercept <- rnorm(
  nlevels(dat_mixed$id),
  mean = 0,
  sd = 1
)

eta <- 10 +
  0.3 * dat_mixed$time +
  2 * (dat_mixed$group == "B") +
  5 * (dat_mixed$group == "C") +
  random_intercept[dat_mixed$id]

dat_mixed$y <- eta +
  rnorm(
    nrow(dat_mixed),
    mean = 0,
    sd = 2
  )


## Linear mixed model with Helmert contrasts

contrasts(dat_mixed$group) <- contr.helmert(3)

mod_lmer <- lmer(
  y ~ group + time + (1 | id),
  data = dat_mixed
)

ContrastsOnePred(
  model = mod_lmer,
  predictor = "group",
  outcome = "y",
  data = dat_mixed,
  estimate_type = "predicted"
)


