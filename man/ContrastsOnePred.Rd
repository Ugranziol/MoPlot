contrasts(dat_mixed$group) <- MASS::contr.sdif(3)

mod_lme <- nlme::lme(
  y ~ group + time,
  random = ~1 | id,
  data = dat_mixed
)

ContrastsOnePred(
  model = mod_lme,
  predictor = "group",
  outcome = "y",
  data = dat_mixed,
  estimate_type = "predicted"
)


## Generalized mixed model with sum contrasts

