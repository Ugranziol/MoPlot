eta_count <- 1.5 +
  0.2 * dat_mixed$time +
  0.3 * (dat_mixed$group == "B") +
  0.7 * (dat_mixed$group == "C") +
  random_intercept[dat_mixed$id]

dat_mixed$count <- rpois(
  nrow(dat_mixed),
  lambda = exp(eta_count)
)

mod_tmb <- glmmTMB(
  count ~ group + time + (1 | id),
  family = poisson,
  data = dat_mixed
)

ContrastsOnePred(
  model = mod_tmb,
  predictor = "group",
  outcome = "count",
  data = dat_mixed,
  estimate_type = "predicted",
